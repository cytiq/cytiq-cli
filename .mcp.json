{
  "mcpServers": {
    "serena": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--python",
        "3.13",
        "--from",
        "serena-agent==2.1.0",
        "serena",
        "start-mcp-server",
        "--context",
        "claude-code",
        "--agent-interface",
        "REPL",
        "--project",
        "${CLAUDE_PROJECT_DIR}",
        "--open-web-dashboard",
        "false",
        "--enable-gui-log-window",
        "false"
      ]
    }
  }
}
